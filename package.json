{
  "name": "ssampin",
  "version": "2.4.3",
  "description": "쌤핀 - 교사용 데스크톱 대시보드",
  "private": true,
  "license": "GPL-3.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"node scripts/electron-dev.mjs\"",
    "electron:dev:fresh": "concurrently -k \"vite\" \"node scripts/electron-dev.mjs --user-data-dir=.dev-data\"",
    "build": "tsc -b && vite build && vite build --config vite.student.config.ts && node scripts/build-electron.mjs",
    "postbuild": "node scripts/check-bundle-isolation.mjs && node scripts/check-contract-sync.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:student": "vite build --config vite.student.config.ts",
    "check:bundle-isolation": "node scripts/check-bundle-isolation.mjs",
    "gen:contract": "node scripts/gen-bridge-contract.mjs",
    "check:contract-sync": "node scripts/check-contract-sync.mjs",
    "gen:entity-samples": "node scripts/emit-entity-samples.mjs",
    "dev:student": "vite --config vite.student.config.ts --port 5175",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "embed": "tsx scripts/embed-docs.ts --all",
    "embed:dry": "tsx scripts/embed-docs.ts --all --dry-run",
    "embed:file": "tsx scripts/embed-docs.ts --file",
    "test:chatbot": "tsx scripts/test-chatbot.ts",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "regression-check": "node scripts/regression-grep-check.mjs",
    "dev:mobile": "vite --config vite.mobile.config.ts --port 5174",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "preview:mobile": "vite preview --config vite.mobile.config.ts",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:dmg": "npm run build && electron-builder --mac dmg",
    "migration-roundtrip": "node scripts/migration-roundtrip.mjs",
    "migration-roundtrip:1-load": "node scripts/migration-roundtrip-1-load.mjs",
    "migration-roundtrip:2-forward": "node scripts/migration-roundtrip-2-forward.mjs",
    "migration-roundtrip:3-backward": "node scripts/migration-roundtrip-3-backward.mjs",
    "migration-roundtrip:4-diff": "node scripts/migration-roundtrip-4-diff.mjs",
    "migration-roundtrip:5-report": "node scripts/migration-roundtrip-5-report.mjs",
    "check-flag-usage": "node scripts/check-flag-usage.mjs",
    "check-hex-hardcoding": "node scripts/check-hex-hardcoding.mjs",
    "check-sp-coverage": "node scripts/check-sp-coverage.mjs",
    "icons:generate": "node scripts/generate-mascot-icons.mjs"
  },
  "dependencies": {
    "@blocknote/ariakit": "~0.47.3",
    "@blocknote/core": "~0.47.3",
    "@blocknote/react": "~0.47.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdfme/common": "^6.0.6",
    "@pdfme/generator": "^6.0.6",
    "@supabase/supabase-js": "^2.49.0",
    "@ubermensch1218/hwpxcore": "^0.1.3",
    "animejs": "^4.5.0",
    "cloudflared": "^0.7.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fabric": "^7.2.0",
    "fflate": "^0.8.3",
    "focus-trap": "^7.8.0",
    "focus-trap-react": "^11.0.6",
    "fractional-indexing": "3.2.0",
    "iconv-lite": "^0.7.2",
    "idb": "^8.0.3",
    "koffi": "^2.16.1",
    "kordoc": "^3.1.1",
    "open-graph-scraper": "^6.11.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-rnd": "^10.5.3",
    "undici": "^6.25.0",
    "ws": "^8.19.0",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.19",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "//overrides": [
    "전이 의존성(우리가 직접 고를 수 없는 하위 패키지)의 취약 버전을 강제로 끌어올리는 곳.",
    "규칙 1 — 정확한 버전(1.8.4)으로 핀하지 말 것. 새 권고가 나오면 그 핀이 '취약 버전 고정'이 되어",
    "  Dependabot/npm audit가 스스로 올리지 못한다. 실제로 2026-08 시점 shell-quote 1.8.4 핀과",
    "  brace-expansion 1.1.17/2.1.3 핀이 정확히 이 이유로 취약 상태를 붙잡고 있었다.",
    "규칙 2 — 반드시 캐럿(^) 범위로 적어 패치 릴리즈를 자동으로 받게 한다.",
    "규칙 3 — 상위 패키지가 스스로 고친 뒤에는 이 항목을 지운다(npm audit에 남지 않으면 불필요)."
  ],
  "//devDependencies": [
    "앱 실행에 필요 없는 패키지는 반드시 여기에 둔다. dependencies 에 있으면 electron-builder 가",
    "설치파일에 그대로 담아 선생님 PC까지 배포되고, 그 패키지의 취약점 알림도 계속 따라온다.",
    "@google/genai — 챗봇 문서 임베딩 스크립트(scripts/embed-docs.ts) 전용. 앱 코드는 import 하지 않는다."
  ],
  "overrides": {
    "brace-expansion@<1.1.18": "^1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
    "brace-expansion@>=4.0.0 <5.0.8": "^5.0.9",
    "shell-quote": "^1.10.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@google/genai": "^1.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "postcss": "^8.5.1",
    "prettier": "3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx,mjs,cjs,json,jsonc,css,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
