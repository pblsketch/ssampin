VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-client-secret-here

# AI 챗봇 답변
# 답변 생성: Claude Haiku 5.5 (WIF 인증, ADR-142). 실패하면 Gemini 로 자동 폴백합니다.
#   서명 키(JWK, kid 포함 한 줄)와 ID 들은 Claude 콘솔의 워크로드 아이덴티티 페더레이션 설정과 짝입니다.
#   ANTHROPIC_API_KEY 는 쓰지 않습니다(있으면 다른 클라이언트가 그 키를 먼저 집습니다).
ANTHROPIC_WIF_SIGNING_JWK={"kty":"EC","crv":"P-256","kid":"...","x":"...","y":"...","d":"..."}
ANTHROPIC_WIF_ISSUER=https://ssampin.com/wif/chatbot
ANTHROPIC_WIF_SUBJECT=ssampin-chat
ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
ANTHROPIC_WORKSPACE_ID=wrkspc_...
# CLAUDE_MODEL=claude-haiku-5-5
# 임베딩(검색용 벡터, gemini-embedding-2 1536차원) + 답변 생성 폴백
GOOGLE_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 앱 내 AI 도우미 + 서명받기(Phase 2B) Edge Functions (Vite 환경변수)
# 비워두면 서명받기 도구는 자동으로 "오프라인 임시 저장" 모드로 떨어집니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 서명받기 공개 링크의 베이스 URL.
# ssampin.com/sign/{code} → 랜딩(landing/vercel.json redirects)이 m.ssampin.com/sign/{code}로 넘기고,
# 실제 페이지는 모바일 PWA 번들(src/mobile/main.tsx)이 처리합니다.
# 미설정 시 발급된 링크가 빈 도메인이 되어 학생이 열 수 없으므로 운영 환경에서는 필수입니다.
VITE_SIGNATURE_PUBLIC_BASE_URL=https://ssampin.com

# 카카오톡 공유 (JavaScript 키 — 도메인 제한으로 클라이언트 노출 OK)
VITE_KAKAO_JS_KEY=your-kakao-javascript-key

# ── AI 시스템 프롬프트 (Supabase 엣지 함수 시크릿 — 저장소에 본문을 두지 않는다) ──
# ADR-072 결정 1. 이 저장소는 공개라 프롬프트를 코드에 적으면 그대로 읽힌다.
# 본문은 여기 적지 말고 Supabase 시크릿으로만 넣는다. 미설정이면 함수가 명시적으로 실패한다.
#   supabase secrets set ASSIST_SYSTEM_PROMPT="$(cat <프롬프트 파일>)"
#   supabase secrets set CHAT_SYSTEM_PROMPT="$(cat <프롬프트 파일>)"
# ASSIST_SYSTEM_PROMPT 는 {{today}} 자리표시자를 포함해야 한다(오늘 날짜가 치환된다).
ASSIST_SYSTEM_PROMPT=
CHAT_SYSTEM_PROMPT=
