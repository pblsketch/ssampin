VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-client-secret-here

# AI 챗봇 관련
GOOGLE_API_KEY=your-gemini-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 앱 내 AI 도우미 + 서명받기(Phase 2B) Edge Functions (Vite 환경변수)
# 비워두면 서명받기 도구는 자동으로 "오프라인 임시 저장" 모드로 떨어집니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 서명받기 공개 링크의 베이스 URL.
# ssampin.com/sign/{code} → 랜딩(landing/vercel.json redirects)이 m.ssampin.com/sign/{code}로 넘기고,
# 실제 페이지는 모바일 PWA 번들(src/mobile/main.tsx)이 처리합니다.
# 미설정 시 발급된 링크가 빈 도메인이 되어 학생이 열 수 없으므로 운영 환경에서는 필수입니다.
VITE_SIGNATURE_PUBLIC_BASE_URL=https://ssampin.com

# 카카오톡 공유 (JavaScript 키 — 도메인 제한으로 클라이언트 노출 OK)
VITE_KAKAO_JS_KEY=your-kakao-javascript-key
